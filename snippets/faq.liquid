<style>
  /* Container */
  .faq-section{
    background:#e9eae6; /* close to your body bg */
    padding: 2rem 1rem 3rem;
    border-radius: 18px;
  }
  .faq-title{
    text-align:center;
    font-size: clamp(24px, 5vw, 40px);
    color:#3b3b3b;
    margin-bottom: .5rem;
  }

  /* List + items */
  .faq-list{
    list-style:none;
    padding-left: 0px;
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    gap: 12px;
  }
  .faq-item details{
    background:#fff;
    border:1.5px solid #cfcfcf;
    border-radius: 12px;
    padding: .5rem .75rem;
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .faq-item details[open]{
    border-color:#bfc6b7;
    box-shadow: 0 1px 0 rgba(0,0,0,.03);
  }

  /* Summary row */
  .faq-item summary{
    list-style:none; /* remove default marker */
    display:flex; align-items:center; justify-content:space-between;
    gap: 1rem;
    cursor:pointer;
    padding: .5rem .25rem;
  }
  .faq-item summary::-webkit-details-marker{ display:none; }

  .faq-q{
    color:#494949;
    font-weight:600;
  }

  /* Toggle icon: + becomes – when open */
  .faq-toggle{
    width:28px; height:28px; border-radius:50%;
    background: var(--primary-color, #c8eb1b);
    display:grid; place-items:center;
    position:relative; flex: 0 0 28px;
  }
  .faq-toggle::before, .faq-toggle::after{
    content:""; position:absolute; background:#232323; border-radius:2px;
  }
  .faq-toggle::before{ width:14px; height:2px; }
  .faq-toggle::after{ width:2px; height:14px; transition:opacity .15s ease; }
  details[open] .faq-toggle::after{ opacity:0; } /* hide vertical bar to make minus */

  /* Answer */
  .faq-a{
    color:#4a4a4a;
    padding: 0 .25rem .75rem .25rem;
    margin-top: .25rem;
    line-height:1.7;
  }

  /* Show more */
  .faq-actions{
    text-align:center;
    margin-top: 1rem;
  }
  .faq-more{
    background: var(--primary-color, #c8eb1b);
    color:#232323;
    border-radius: 999px;
    padding:.6rem 1rem;
    font-weight:600;
    box-shadow: 0 1px 0 rgba(0,0,0,.05);
    cursor:pointer;
  }

  /* Hide the extra items initially (JS also adds/removes this class) */
  .hide-initial{ display:none; }

  /* Small tweaks */
  @media (min-width: 768px){
    .faq-item details{ padding: .75rem 1rem; }
  }
</style>

<script>
  (function(){
    const list   = document.querySelector('.faq-list');
    const moreBt = document.querySelector('.faq-more');
    if(!list || !moreBt) return;

    const hidden = () => list.querySelectorAll('.hide-initial');
    const showAll = () => hidden().forEach(li => li.classList.remove('hide-initial'));
    const hideAll = () => hidden().length === 0 && list.querySelectorAll('.faq-item').forEach((li, idx) => {
      if (idx >= 2) li.classList.add('hide-initial');
    });

    // ensure only first 2 are visible on load
    list.querySelectorAll('.faq-item').forEach((li, idx) => {
      if (idx >= 2) li.classList.add('hide-initial');
    });

    moreBt.addEventListener('click', () => {
      const anyHidden = hidden().length > 0;
      if (anyHidden) {
        showAll();
        moreBt.textContent = 'Show fewer questions';
      } else {
        hideAll();
        moreBt.textContent = 'Show more questions';
        // scroll back to list top for context
        list.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  })();
</script>

