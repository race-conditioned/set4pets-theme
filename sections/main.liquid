<div class="main">
  <section class="hero">
    {% render 'hero-video' %}
  </section>

  <section class="product">
    {% render 'intro-cta' %}
  </section>

  <div class="image-wrapper">
    <img src="{{ 's4p1.png' | asset_url }}" alt="set 4 pets product with dog" class="product-image1">
  </div>

  <section class="appeal-cta raised">
    {% render 'icon-appeal-cta' %}
  </section>

  <section class="appeal-cta raised">
    {% render 'feature-icons' %}
  </section>

  <section class="appeal-cta raised">
    {% render 'video-caro' %}
  </section>

  <section class="hero">
    {% render 'product-specs' %}
  </section>

  <section class="hero">
    {% render 'how2steps' %}
  </section>

  <section class="appeal-cta raised">
    {% render 'reviews' %}
  </section>

  <section class="appeal-cta raised">
    {% render 'faq' %}
  </section>

  <section class="appeal-cta raised">
    {% render 'photo-caro' %}
  </section>

  <section class="about flex">
    {% render 'about' %}
  </section>

  <section class="footer">
    {% render 'footer' %}
  </section>
</div>

{% schema %}
{
  "name": "Main Section",
  "settings": [
    {
      "type": "text",
      "id": "product_heading",
      "label": "Product Heading",
      "default": "Premium Backpack Carrier"
    },
    {
      "type": "text",
      "id": "product_subheading",
      "label": "Product Subheading",
      "default": "Safety, Comfort, Quality"
    },
    {
      "type": "image_picker",
      "id": "s4p1",
      "label": "Sets 4 Pets 1"
    }
  ]
}
{% endschema %}

